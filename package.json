{
  "name": "paymentlab-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "test": "node --test test/*.test.mjs",
    "sandbox:smoke": "node scripts/m3-sandbox-smoke.mjs",
    "docs:phases": "node scripts/build-phase-html.mjs",
    "docs:phases:validate": "node scripts/check-phase-html.mjs",
    "docs:phases:check": "node scripts/build-phase-html.mjs --check && npm run docs:phases:validate",
    "docs:preview": "node scripts/serve-phase-docs.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.6.1"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "7.0.2"
  }
}
